{
  "name": "radar-varons",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev:ingest": "wrangler dev --config apps/radar-worker/wrangler.ingest.jsonc",
    "dev:ops": "wrangler dev --config apps/radar-worker/wrangler.ops.jsonc",
    "deploy:ingest": "wrangler deploy --config apps/radar-worker/wrangler.ingest.jsonc",
